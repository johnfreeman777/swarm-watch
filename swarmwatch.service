[Unit]
Description=Swarm Watch: Telegram bot watching IMD swarm seats from public data
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=swarmwatch
Group=swarmwatch
Environment=SWARMWATCH_TOKEN_FILE=/etc/swarmwatch/token
Environment=SWARMWATCH_DB=/var/lib/swarmwatch/db.sqlite
EnvironmentFile=-/etc/swarmwatch/env
ExecStart=/usr/bin/python3 /opt/swarmwatch/swarmwatch.py
Restart=always
RestartSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/swarmwatch
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
